ADMIN_PASSWORD="your_admin_password_here"

# ── LLM provider ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat completions API works. Leave these unset to use a
# local Ollama server (qwen2.5:7b). Uncomment ONE block to use a hosted provider.

# Groq (free tier, very fast)
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="gsk_..."
# LLM_MODEL="llama-3.3-70b-versatile"

# Google Gemini (free tier via AI Studio)
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_API_KEY="AIza..."
# LLM_MODEL="gemini-2.5-flash-lite"

# OpenRouter (":free" models; a one-time $10 credit raises the daily cap)
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="sk-or-..."
# LLM_MODEL="qwen/qwen-2.5-72b-instruct:free"

# ── Optional tuning ────────────────────────────────────────────────────────────
# LLM_MAX_TOKENS=8192     # upper bound on max_tokens for any single request
# LLM_REASONING_BUDGET=2000  # extra tokens per request for reasoning models (their hidden thinking counts against max_tokens)
# LLM_TIMEOUT=600         # request timeout in seconds
# LLM_MAX_RETRIES=4       # retries on rate limits / server errors (backoff 2s, 8s, 20s, 45s)
# LLM_CONCURRENCY=8       # max LLM requests in flight at once (lower for strict free tiers)
# LLM_JSON_SCHEMA=true    # set false if your provider rejects response_format json_schema
